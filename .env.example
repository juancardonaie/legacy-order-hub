# Plantilla de configuración de Legacy OrderHub (RNF-02.1).
#
# Cópiala a `.env` y rellena los valores reales:
#
#     cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.
# Este archivo, en cambio, sí se versiona: documenta qué variables existen,
# por eso no contiene ningún valor real.

# Entorno de ejecución: development | staging | production
# Fuera de "development", la ausencia de JWT_SECRET_KEY o FLASK_SECRET_KEY
# aborta el arranque en vez de caer a un valor por defecto inseguro.
APP_ENV=development

# Clave de firma de los JWT (HS256). Mínimo 32 bytes.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Algoritmo de firma del token.
JWT_ALGORITHM=HS256

# Minutos de validez del token emitido en /login.
JWT_EXPIRATION_MINUTES=60

# Clave de sesión de Flask. Debe ser distinta de JWT_SECRET_KEY.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Ruta del fichero SQLite.
DATABASE_PATH=orderhub.db
