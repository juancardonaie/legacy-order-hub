# Plantilla de configuración de Legacy OrderHub (RNF-02.1).
#
# Cópiala a `.env` y rellena los valores reales:
#
#     cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.
# Este archivo, en cambio, sí se versiona: documenta qué variables existen,
# por eso no contiene ningún valor real.

# Entorno de ejecución: development | staging | production
# Fuera de "development", la ausencia de JWT_SECRET_KEY o FLASK_SECRET_KEY
# aborta el arranque en vez de caer a un valor por defecto inseguro.
APP_ENV=development

# Clave de firma de los JWT (HS256). Mínimo 32 bytes.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Algoritmo de firma del token.
JWT_ALGORITHM=HS256

# Minutos de validez del token emitido en /login.
JWT_EXPIRATION_MINUTES=60

# Clave de sesión de Flask. Debe ser distinta de JWT_SECRET_KEY.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Ruta del fichero SQLite.
DATABASE_PATH=orderhub.db

# Activa el modo debug de Flask (recarga automática y depurador de Werkzeug).
# Apagado por defecto. Valores que lo activan: 1, true, yes.
# NUNCA lo actives fuera de tu máquina local: el depurador permite ejecutar código.
APP_DEBUG=

# --- Servidor y despliegue -------------------------------------------------
# Solo afectan a `python app.py`. En producción se usa `gunicorn app:app`
# (gunicorn.conf.py), que lee PORT y APP_HOST con los mismos nombres.
#
# Puerto de escucha. Vacío = 5001. Las plataformas PaaS lo definen solas.
PORT=
# Host de escucha. Vacío = 127.0.0.1 (solo tu máquina). Usa 0.0.0.0 únicamente
# detrás de un proxy o en un contenedor. Con APP_DEBUG activo, solo loopback.
APP_HOST=

# Primer administrador. Con APP_ENV distinto de "development" no se siembran
# admin/juan, así que sin estas dos variables no existe ningún usuario. Se crea
# al arrancar si no existe (idempotente) y la contraseña se guarda con bcrypt.
# Defínelas siempre juntas; la contraseña no puede superar 72 bytes.
ADMIN_USERNAME=
ADMIN_PASSWORD=
